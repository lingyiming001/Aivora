DATABASE_URL=jdbc:postgresql://localhost:15432/aivora
DATABASE_USER=aivora
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
PROVIDER_ENCRYPTION_KEY=
REDIS_HOST=localhost
REDIS_PORT=16379
CORS_ORIGIN=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
SPRING_PROFILES_ACTIVE=
POSTGRES_PORT=15432
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001

# 本地测试可设置 SPRING_PROFILES_ACTIVE=dev；会启用测试验证码与角色卡。
# 生产环境不要启用 dev；未配置真实短信时仅允许账号密码登录。

# 每个游客会话的体验星币（服务端记录）
AIVORA_GUEST_STARS=10

# Optional OBS RTMP + HLS media service (disabled until explicitly enabled)
AIVORA_MEDIA_ENABLED=false
AIVORA_RTMP_PUBLIC_URL=rtmp://localhost:1935/live
# Native backend: http://127.0.0.1:18085 ; container backend: http://media:8080
AIVORA_HLS_INTERNAL_URL=http://127.0.0.1:18085
