    </dependency>
    <dependency>
      <groupId>com.aivora</groupId>
      <artifactId>aivora-auth</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aivora</groupId>
      <artifactId>aivora-user</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aivora</groupId>
      <artifactId>aivora-wallet</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aivora</groupId>
      <artifactId>aivora-payment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aivora</groupId>
